# ── Melodex Environment Variables ─────────────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# App
ENVIRONMENT=production
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION

# Database
DATABASE_URL=postgresql+asyncpg://melodex:melodex_pass@postgres:5432/melodex

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage (local or S3)
STORAGE_PATH=/app/downloads
MAX_FILE_AGE_HOURS=24

# Optional: AWS S3 (leave blank to use local storage)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Optional: YouTube cookies (for age-gated content)
YT_DLP_COOKIES_FILE=

# Optional: Proxy (e.g., for geo-restricted content)
YT_DLP_PROXY=

# Rate limiting
RATE_LIMIT_PER_IP=30
MAX_URLS_PER_REQUEST=50
MAX_CONCURRENT_DOWNLOADS=20

# CORS
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Optional: Sentry for error tracking
SENTRY_DSN=
